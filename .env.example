# Copie para apps/web/.env.local e preencha. Nunca commite .env.local.

# Gerador de SiteSpec: mock | anthropic | openai (openai ainda não existe).
# mock = sites de exemplo, só para o dev local e deploys de Preview. Em produção na Vercel
# (VERCEL_ENV=production) o mock é recusado: use AI_PROVIDER=anthropic com ANTHROPIC_API_KEY.
AI_PROVIDER=mock

# Obrigatória com AI_PROVIDER=anthropic (sem ela, criar/editar com IA dá erro antes de gastar crédito).
ANTHROPIC_API_KEY=
# Opcional: outro modelo do Claude para criar sites (padrão: claude-sonnet-5-5)
# e para as edições com IA (padrão: claude-haiku-5-5, bem mais barato).
ANTHROPIC_MODEL=
ANTHROPIC_EDIT_MODEL=
# Criar site a partir do site-modelo da categoria com o modelo de edição (barato), voltando para
# o caminho completo se falhar. Padrão ligado; "false" desliga.
AI_MODEL_FIRST=
# Limite diário de uso da IA por conta (padrão: 5 sites gerados e 30 pedidos de mudança).
AI_DAILY_GENERATIONS=
AI_DAILY_EDITS=
OPENAI_API_KEY=

# Supabase (opcional no dev; obrigatório em produção). Ver DEPLOY.md.
# Sem estas duas, os sites ficam só em memória (no dev). Em produção na Vercel, faltar uma delas
# é erro (as páginas que leem sites respondem 500 em vez de perder os dados).
NEXT_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA (sb_publishable_...), usada no login. Sem ela, o login fica desligado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA: só no servidor, nunca no navegador nem no Git.
SUPABASE_SERVICE_ROLE_KEY=

# Domínios de clientes: token da Vercel (Account Settings → Tokens). Opcional no dev.
# VERCEL_PROJECT_ID / VERCEL_TEAM_ID têm padrão no código (server/domains/vercel.ts).
VERCEL_TOKEN=

# Fotos de banco de imagens para o topo dos sites (opcional; sem chave, o site fica sem foto).
# Pexels (preferido, grátis): https://www.pexels.com/api/ → "Your API Key".
PEXELS_API_KEY=
# Unsplash (reserva): https://unsplash.com/developers → app → "Access Key".
UNSPLASH_ACCESS_KEY=

# E-mails pela Resend (https://resend.com → API Keys). Opcional no dev; OBRIGATÓRIO antes de vender
# (DEPLOY.md, "Antes de vender"). Sem a chave: os pedidos do formulário só aparecem no painel, não
# saem lembretes de vencimento do plano nem alertas de erro.
RESEND_API_KEY=
# Remetente do aviso de pedidos (domínio verificado na Resend). Padrão: NoSweat <leads@nosweatfd.com>
LEADS_FROM_EMAIL=
# Remetente dos e-mails do plano liberado à mão ("plan is active" e lembretes de vencimento).
# Padrão: No Sweat <billing@nosweatfd.com> (domínio verificado na Resend). Esses e-mails usam a
# RESEND_API_KEY, o APP_URL nos links e o SALES_EMAIL para o resumo diário da equipe.
BILLING_FROM_EMAIL=
# Remetente dos avisos do Instagram. Padrão: No Sweat <hello@nosweatfd.com>
SOCIAL_FROM_EMAIL=
# Endereço do painel usado nos links dos e-mails (pedidos, lembretes). Em produção:
# https://www.nosweatfd.com (com www; o endereço sem www redireciona).
APP_URL=
# Alertas de erro de produção: e-mail (ou vários, separados por vírgula) que recebe um aviso
# quando uma página, rota da API ou Server Action falha (no máximo 1 por rota a cada 10 min).
# Precisa da RESEND_API_KEY. Vazio = sem alertas.
ALERT_EMAIL=

# Segredo dos crons (/api/cron/*): a Vercel e o Supabase (Vault, DEPLOY.md Passo 7.6) mandam
# "Authorization: Bearer <CRON_SECRET>". Sem ele, os crons respondem 401 e nada roda.
# Gerar com: openssl rand -hex 32
CRON_SECRET=

# Fotos enviadas pelo dono usam o Supabase Storage (bucket site-images, migration 0008).
# Sem Supabase configurado, o envio de fotos responde 501.

# Dev local sem Supabase: "true" deixa o DEV_USER ver o painel /admin.
# Em produção, admins ficam na tabela public.platform_admins (ver supabase/migrations/0004).
DEV_ADMIN=

# Limites diários da IA para visitantes sem conta (opcionais; padrões em server/quota.ts).
# GUEST_DAILY_GENERATIONS=2
# GUEST_IP_DAILY_GENERATIONS=4
# GUEST_GLOBAL_DAILY_GENERATIONS=300
# GUEST_DAILY_EDITS=5
# GUEST_IP_DAILY_EDITS=15
# GUEST_GLOBAL_DAILY_EDITS=2000
# Sal do hash de IP (qualquer texto aleatório e secreto).
# IP_HASH_SALT=

# Captcha no cadastro e login (Cloudflare Turnstile, grátis): https://dash.cloudflare.com → Turnstile.
# A chave do SITE vai aqui; a chave SECRETA vai no Supabase (Authentication → Attack Protection
# → Captcha, provedor "Turnstile"). Ligue os dois juntos. Sem a chave do site, sem captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# E-mail de boas-vindas da lista de lançamento (marketing; usa a mesma RESEND_API_KEY).
# Remetente (domínio verificado na Resend). Padrão: No Sweat <hello@nosweatfd.com>
MARKETING_FROM_EMAIL=
# Endereço postal da empresa (obrigatório pelo CAN-SPAM em todo e-mail de marketing; pode ser
# uma caixa postal). Sem ele, o e-mail de boas-vindas NÃO é enviado (o contato fica na lista).
MARKETING_POSTAL_ADDRESS=

# Cobrança (Stripe). Sem estas duas, publicar continua grátis. Ver DEPLOY.md, Passo 6.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Cobrança à mão (Pix/WhatsApp), sem Stripe: REQUIRE_PLAN=true faz publicar exigir plano, e o
# admin libera o acesso por X dias em /admin → Manage. Os botões dos planos abrem o WhatsApp
# (só dígitos, com código do país) ou, sem ele, o e-mail de vendas.
# REQUIRE_PLAN=true
# SALES_WHATSAPP: além do /billing, liga o link PÚBLICO "Chat on WhatsApp" no rodapé do site de
# marketing, o "message us on WhatsApp" do FAQ da landing e a ajuda do painel. Vazio = nada
# disso aparece. A landing é estática: mudar a variável exige Redeploy.
# SALES_WHATSAPP=15085550142
# SALES_EMAIL=hello@nosweatfd.com

# Redes sociais (Instagram). Sem estas chaves, no dev local o /social usa o cliente de mentira
# (conta @mock_business) e nada vai para o Instagram. Ver DEPLOY.md, Passo 7.
# App ID e App Secret do INSTAGRAM (não os do app da Meta): developers.facebook.com → seu app →
# Instagram → API setup with Instagram login. O secret é SECRETO: só na Vercel.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Tem que ser igual, letra por letra, ao "OAuth redirect URI" cadastrado no app.
# INSTAGRAM_REDIRECT_URI=https://www.nosweatfd.com/api/social/instagram/callback
# Versão da Graph API (padrão no código: v26.0).
# META_GRAPH_VERSION=v26.0
# Chave que criptografa os tokens do Instagram no banco (AES-256-GCM). Gerar com:
#   openssl rand -base64 32
# e colar como "v1:<resultado>". Guarde uma cópia: se perder a chave, todos os clientes precisam
# reconectar o Instagram. Para trocar a chave, coloque a nova na frente: "v2:<nova>,v1:<antiga>"
# (a primeira criptografa, todas abrem; o cron de renovação recriptografa com a nova).
# Em produção (com Supabase) sem esta variável, conectar contas fica desligado.
# SOCIAL_TOKEN_KEYS=v1:...
# Enquanto o App Review da Meta não for aprovado, só testadores publicam de verdade (padrão true).
# Testadores: e-mails da conta No Sweat, separados por vírgula (admins já contam).
# SOCIAL_TESTER_ONLY=true
# SOCIAL_TESTER_EMAILS=
# Máximo de posts publicados por conta do Instagram por dia (padrão 10).
# SOCIAL_DAILY_POST_CAP=10
# Post atrasado mais que isto (horas) não é publicado: vira "missed" e o dono remarca (padrão 6).
# SOCIAL_MAX_LATENESS_HOURS=6
# Limites diários da IA nas redes sociais, por conta (admins sem limite; visitantes: 0).
# AI_DAILY_SOCIAL_PLANS=3
# AI_DAILY_SOCIAL_CAPTIONS=30

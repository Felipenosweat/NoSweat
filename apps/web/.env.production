# Valores PÚBLICOS usados no build de produção (Vercel). Nada secreto aqui:
# a chave publishable do Supabase vai para o navegador de qualquer forma.
# Segredos (SUPABASE_SERVICE_ROLE_KEY, chaves de IA) ficam só nas variáveis da Vercel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_huL4ESDFVu0jn7UIuqyBSA_8MHl-Juv

# Endereço oficial (links de confirmação de e-mail e volta do login com Google). Com "www":
# na Vercel, nosweatfd.com redireciona para www.nosweatfd.com (ver lib/site.ts). Tem que bater
# com o Site URL e as Redirect URLs do Supabase (DEPLOY.md, Passo 1).
NEXT_PUBLIC_SITE_URL=https://www.nosweatfd.com

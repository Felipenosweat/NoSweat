{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx --yes pnpm@10.28.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.28.0 run build",
  "crons": [
    {
      "path": "/api/cron/cleanup-guests",
      "schedule": "17 7 * * *"
    },
    {
      "path": "/api/cron/social-publish",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/cron/social-refresh",
      "schedule": "23 8 * * *"
    }
  ]
}
